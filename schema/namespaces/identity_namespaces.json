{
  "_meta": {
    "version": "1.0.0",
    "description": "Registry of all known identity signal types. Every identifier captured anywhere in the stack must be registered here. Namespaces follow the pattern: {category}.{vendor}.{signal_name}",
    "categories": {
      "platform_click_id":    "Deterministic click IDs appended to URLs by ad platforms",
      "platform_cookie":      "Browser-side cookies set by ad platform pixels",
      "platform_user_id":     "User-scoped IDs from ad platforms (logged-in matching)",
      "analytics_cookie":     "Browser-side cookies set by analytics platforms",
      "analytics_user_id":    "User IDs set by the org inside an analytics platform",
      "analytics_session_id": "Session-scoped identifiers from analytics platforms",
      "crm_id":               "IDs from CRM or marketing automation platforms",
      "first_party_hashed":   "PII hashed by the org before storage (SHA-256 unless noted)",
      "first_party_raw":      "Non-PII first-party identifiers (internal customer/user IDs)",
      "device_id":            "Device-level identifiers (mobile OS, fingerprint-derived)",
      "network":              "Network-level signals (IP address, ASN)",
      "cohort":               "Privacy-preserving cohort or aggregated signals",
      "custom":               "Org-defined identifiers not covered by other categories"
    }
  },

