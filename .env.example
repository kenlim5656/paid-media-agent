# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GCP / BigQuery ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project
GCP_DATASET_ID=paid_media                       # must match paid-media-schema dataset
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Salesforce (optional — falls back to BQ staging table if unset) ────────────
SF_USERNAME=user@company.com
SF_PASSWORD=...
SF_SECURITY_TOKEN=...
SF_DOMAIN=login                                 # or 'test' for sandbox

# ── Google Marketing Platform (GMP) ────────────────────────────────────────────
CM360_PROFILE_ID=12345678
DV360_PARTNER_ID=12345678
SA360_AGENCY_ID=12345678

# ── Meta Ads ───────────────────────────────────────────────────────────────────
# Create a System User in Meta Business Manager → Business Settings → Users → System Users
# Grant it advertiser access and generate a token with ads_management + ads_read scope
META_APP_ID=123456789
META_APP_SECRET=abc123...
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx             # long-lived system user token
META_AD_ACCOUNT_ID=act_123456789                 # include the "act_" prefix

# ── LinkedIn Marketing API ─────────────────────────────────────────────────────
# Create an app at developer.linkedin.com → Products → Marketing Developer Platform
# Request: r_ads, rw_ads, r_dmp_profile, rw_dmp_profile scopes
# Complete the OAuth flow and get a long-lived token (60-day expiry — set up token refresh)
LINKEDIN_CLIENT_ID=78xxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxx
LINKEDIN_ACCESS_TOKEN=AQXxxxxxxxxxxxxxxxxxx
LINKEDIN_PARTNER_ID=123456                       # found in Campaign Manager → Account Assets

# ── TikTok Ads (optional) ──────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ── Notifications ──────────────────────────────────────────────────────────────
GTM_SERVER_CONTAINER_URL=https://gtm.yourdomain.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Operator guardrails ────────────────────────────────────────────────────────
MAX_BUDGET_SHIFT_PCT=10                          # max % of any budget to move per run
OPERATOR_REQUIRE_APPROVAL=true                   # set false only after extended validation

# ── Attribution model ──────────────────────────────────────────────────────────
ATTRIBUTION_LOOKBACK_DAYS=90
SHAPLEY_MAX_CHANNELS=10                          # cap for Shapley computation
SHAPLEY_MAX_PATHS=10000                          # sample paths above this count
