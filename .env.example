# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# GCP
GCP_PROJECT_ID=your-gcp-project
GCP_DATASET_ID=attribution
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Salesforce
SF_USERNAME=user@company.com
SF_PASSWORD=...
SF_SECURITY_TOKEN=...
SF_DOMAIN=login  # or 'test' for sandbox

# Google Marketing Platform
CM360_PROFILE_ID=12345678
DV360_PARTNER_ID=12345678
SA360_AGENCY_ID=12345678

# GTM Server-Side
GTM_SERVER_CONTAINER_URL=https://gtm.yourdomain.com

# Guardrails
MAX_BUDGET_SHIFT_PCT=10        # operator: max % of budget to reallocate in one run
OPERATOR_REQUIRE_APPROVAL=true # set false only after extended testing
ALERT_WEBHOOK_URL=https://hooks.slack.com/...
